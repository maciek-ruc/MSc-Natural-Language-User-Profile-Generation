DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_NAME=arxiv_db

# OpenAI-compatible endpoint used for profile generation.
LLM_GEN_BASE_URL=https://api.openai.com
GEN_MODEL=gpt-4.1-mini

# OpenAI-compatible endpoint used for judging.
LLM_JUDGE_API_BASE=https://api.openai.com
JUDGE_MODEL=gpt-4.1-mini

# Provide your own API key for whichever endpoint you use.
OPENAI_API_KEY=your_api_key_here

# Alternative generic key names supported by the client.
# LLM_API_KEY=your_api_key_here
# OLLAMA_API_KEY=your_api_key_here